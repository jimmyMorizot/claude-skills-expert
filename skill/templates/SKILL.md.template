---
name: {{NAME}}
# Lowercase letters, digits and hyphens, max 64 characters, no leading/trailing hyphen, no "--".
# Must be identical to the skill directory name (required by the agentskills.io standard).

description: {{DESCRIPTION}}
# What the skill does and when to use it. Front-load the key use case with the words users would say.
# Claude Code truncates description + when_to_use at 1,536 characters; claude.ai accepts at most 1,024.
# Keep it short: when the listing overflows, the least-invoked skills lose their description first.
# Do not summarize the skill's internal workflow here.

argument-hint: {{ARGUMENT_HINT}}
# Claude Code only (refused by claude.ai). Autocomplete hint. Quote values with brackets: "[filename]",
# or YAML reads them as a list (loads anyway on 2.1.308). Remove if the skill takes no arguments.

allowed-tools: {{ALLOWED_TOOLS}}
# Tools pre-approved during the turn that invokes the skill; the grant clears at the next message.
# Pre-approves only, restricts nothing. Scope to the strict minimum. Remove if not needed.

# Optional Claude Code fields: uncomment only if needed. None of them is accepted by claude.ai.
# when_to_use: ...                 # Extra trigger phrases or example requests, appended to description.
# arguments: issue branch          # Named positions: $issue = first argument, $branch = second.
# disallowed-tools: AskUserQuestion  # Tools removed while the skill is active (clears at next message).
# disable-model-invocation: true   # Manual only (/name). Use for side effects: deploy, send, commit.
# user-invocable: false            # Hidden from the / menu; only Claude invokes it.
# model: inherit                   # Model for the current turn only; same values as /model, or inherit.
# effort: high                     # low | medium | high | xhigh | max; available levels depend on the model.
# context: fork                    # Run in an isolated subagent (no conversation history).
# agent: Explore                   # Subagent type with context: fork (default: general-purpose).
# background: false                # With context: fork, wait for the result in the same turn.
# hooks: ...                       # Hooks registered at invocation, active until the session ends.
# shell: bash                      # bash (default) | powershell, for injected commands (spec section 10).
# paths: "*.twig"                  # Conditional activation: the skill stays invisible, even for /name,
#                                  # until Claude reads or edits a matching file. Only for file-bound
#                                  # knowledge skills; never for a skill called by /name at session start.

# Optional fields accepted by both Claude Code and claude.ai (agentskills.io standard):
# license: MIT
# compatibility: Requires Python 3 and git   # max 500 characters
# metadata:
#   version: "1.0"                 # string values only, quote numbers
